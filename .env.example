# Configuração local do Google Maps Scraper Kit.
# Para começar: cp .env.example .env
#
# O motor escuta apenas em 127.0.0.1. Outras máquinas não devem acessá-lo.
# Requisições com Host ou Origin incompatíveis com localhost são recusadas.

# Porta do serviço (padrão: 8080).
# Escolha outra porta se 8080 estiver ocupada e reinicie o motor.
SCRAPER_PORT=8080

# Endereço completo da API utilizado pelos scripts clientes, quando necessário.
# Quando definido, substitui a porta padrão para o cliente scrape.py.
# SCRAPER_BASE_URL=http://localhost:8080

# Para executar duas cópias do kit, use portas diferentes.
# Ao usar Docker, configure também projetos Compose com nomes distintos.
# COMPOSE_PROJECT_NAME=gmaps-kit-ptbr

# Chave opcional. Se preenchida, endpoints protegidos exigem X-API-Key.
# Nunca faça commit de chaves e senhas. Em uso local básico, pode ficar vazia.
SCRAPER_API_KEY=

# Modo com janela: 0 abre o navegador visível quando suportado.
# Por padrão o navegador é headless. O shell headless baixado não abre janela.
# No Docker, o navegador permanece em modo sem janela.
# SCRAPER_HEADLESS=0

# Aviso de atualização: defina 1 para desativar as consultas periódicas de versão.
# SCRAPER_NO_UPDATE_CHECK=1
